# Лига и сезон. YEAR — год сезона в URL/API ESPN.
LEAGUE_ID=your_league_id_here
SEASON_YEAR=2027

# Необязательно: команда, которая будет выбрана при первом запуске.
# Если оставить пустым, приложение выберет первую команду лиги.
DEFAULT_TEAM_ID=

# ESPN API credentials
# Получите эти значения из cookies ESPN Fantasy Basketball:
# 1. Откройте https://fantasy.espn.com/basketball/
# 2. Нажмите F12 (Developer Tools)
# 3. Application/Storage → Cookies → espn.com
# 4. Найдите espn_s2 и SWID
# 5. Скопируйте значения сюда

ESPN_S2=your_espn_s2_token_here
SWID={your-swid-guid-here}

# Обычно эти значения менять не нужно.
CORS_ORIGINS=
VITE_API_URL=/api
